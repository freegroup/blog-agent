# Secrets. Kopie als `.env` anlegen und ausfüllen — `.env` bleibt lokal.
# Nur Werte, keine Anführungszeichen. Bereits gesetzte Umgebungsvariablen gewinnen.

# --- LLM ---------------------------------------------------------------
# Provider `anthropic`.
ANTHROPIC_API_KEY=
# Nur für Provider `openai-compatible` (Ollama u.a. brauchen keinen).
LLM_API_KEY=
# Provider `gemini` (Google). Derselbe Key erzeugt auch Titelbilder
# (siehe Bildgenerierung unten). Leer lassen, wenn Gemini nicht genutzt wird.
GEMINI_API_KEY=

# --- Sprachnachrichten -------------------------------------------------
# Vorgabe ist STT über Google Gemini — nutzt GEMINI_API_KEY (oben), kein eigener Key.
# Nur für provider: whisper-http mit einem Dienst, der einen Key braucht:
STT_API_KEY=

# --- Bildgenerierung ---------------------------------------------------
# Der `illustrate`-Schritt erzeugt Titelbilder über Google Gemini und nutzt
# denselben GEMINI_API_KEY wie die LLM-Profile (siehe oben) — kein eigener Key.

# --- Telegram ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GitHub (nur ecosystem.config.cjs, nicht local) --------------------
GITHUB_TOKEN=
GITHUB_OWNER=
