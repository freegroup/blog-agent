# Secrets. Kopie als `.env` anlegen und ausfüllen — `.env` bleibt lokal.
# Nur Werte, keine Anführungszeichen. Bereits gesetzte Umgebungsvariablen gewinnen.

# --- LLM ---------------------------------------------------------------
# Provider `anthropic`.
ANTHROPIC_API_KEY=
# Nur für Provider `openai-compatible` (Ollama u.a. brauchen keinen).
LLM_API_KEY=
# Provider `gemini` (Google). Derselbe Key erzeugt auch Titelbilder
# (siehe Bildgenerierung unten). Leer lassen, wenn Gemini nicht genutzt wird.
GEMINI_API_KEY=

# --- Sprachnachrichten -------------------------------------------------
# Vorgabe ist STT über Google Gemini — nutzt GEMINI_API_KEY (oben), kein eigener Key.
# Nur für provider: whisper-http mit einem Dienst, der einen Key braucht:
STT_API_KEY=

# --- Bildgenerierung ---------------------------------------------------
# Der `illustrate`-Schritt erzeugt Titelbilder über Google Gemini und nutzt
# denselben GEMINI_API_KEY wie die LLM-Profile (siehe oben) — kein eigener Key.

# --- Telegram ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GitHub (nur ecosystem.config.cjs, nicht local) --------------------
GITHUB_TOKEN=
GITHUB_OWNER=

# --- Instagram ---------------------------------------------------------
# Fuer den Instagram-Sink. Nutzt die "Instagram API with Instagram Login"
# (ohne Facebook-Seite). Voraussetzung: ein Instagram-Business- oder Creator-Konto
# und eine Meta-App mit dem Use-Case "Manage messaging & content on Instagram".
#
# Schnellstart ohne Secret (empfohlen):
#   ACCESS_TOKEN:   Im Instagram-App-Dashboard (Use-Case -> API setup with Instagram
#                   login) von Hand ein Token erzeugen und hier eintragen. Der Sink
#                   ermittelt die USER_ID daraus selbst und postet direkt. Er
#                   verlaengert das Token eigenstaendig (kein Secret noetig).
# Voller OAuth-Flow (Alternative):
#   APP_ID/APP_SECRET:  die *Instagram*-App-ID/-Secret (stehen unter dem Instagram-
#                       Use-Case, NICHT unter App-Einstellungen > Basis). Dann
#                       http://localhost:<port>/oauth/start im Browser oeffnen — der
#                       Sink holt Token + USER_ID und schreibt sie hier hinein.
#   TOKEN_EXPIRES_AT:   Unix-Timestamp (Sekunden) — wird vom Sink gesetzt, nicht anfassen.
#   USER_ID:            Instagram User ID — wird ermittelt und gesetzt, nicht anfassen.
# Hinweis: Neue Apps starten im Development Mode (Posts nur fuer dich sichtbar).
# Fuer oeffentliche Posts App Review bei Meta beantragen (Live Mode).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_TOKEN_EXPIRES_AT=
INSTAGRAM_USER_ID=

# --- Pinterest ---------------------------------------------------------
# Fuer den Pinterest-Sink. Voraussetzung: ein Pinterest-BUSINESS-Konto und eine
# App auf developers.pinterest.com.
#   APP_ID / APP_SECRET:  stehen in der App (die "confidential client"-Zugangsdaten)
#                         — die traegst du selbst ein.
#   REFRESH_TOKEN:        LEER lassen. Der Sink holt ihn beim einmaligen OAuth-Flow
#                         (http://localhost:<port>/oauth/start im Browser oeffnen) und
#                         schreibt ihn hier selbst hinein; bei einer Rotation
#                         aktualisiert er ihn ebenfalls. Der Access-Token (30 Tage
#                         gueltig) wird daraus im Betrieb erzeugt und nirgends gespeichert.
# Hinweis: Neue Apps starten im Trial-Modus (Pins sind nur als Sandbox fuer dich
# sichtbar). Fuer oeffentliche Pins bei Pinterest "Standard Access" beantragen.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REFRESH_TOKEN=
# PINTEREST_ACCESS_TOKEN: Abkuerzung ohne OAuth/Secret. Ein im App-Dashboard von Hand
#                         erzeugtes Token (Sandbox oder "Produktion begrenzt") hier
#                         eintragen -> der Sink postet direkt damit. Kein Auto-Refresh:
#                         laeuft es ab, im Dashboard neu erzeugen und ersetzen. Fuer
#                         Sandbox zusaetzlich api_url auf den Sandbox-Host stellen.
PINTEREST_ACCESS_TOKEN=
